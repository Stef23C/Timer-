  <script>
    const activities = {
      play: { symbol: "🧩", name: "Jeu" },
      break: { symbol: "☕", name: "Pause" },
      draw: { symbol: "🎨", name: "Dessin" }
    };
    let totalSeconds = 300, remainingSeconds = 300, deadline = 0;
    let state = "ready", interval = null, soundEnabled = false, audioContext = null;
    const timeEl = document.getElementById("time");
    const dial = document.getElementById("dial");

    function render() {
      const seconds = Math.max(0, Math.ceil(remainingSeconds));
      timeEl.textContent = String(Math.floor(seconds / 60)).padStart(2, "0") + ":" + String(seconds % 60).padStart(2, "0");
      dial.style.setProperty("--progress", (Math.max(0, remainingSeconds) / totalSeconds * 100) + "%");
      ["ready", "running", "paused", "done"].forEach(s =>
        document.getElementById("status-" + s).classList.toggle("hidden", state !== s)
      );
      document.getElementById("start").classList.toggle("hidden", state !== "ready" && state !== "done");
      document.getElementById("pause").classList.toggle("hidden", state !== "running");
      document.getElementById("resume").classList.toggle("hidden", state !== "paused");
    }
    function stopClock() { if (interval !== null) clearInterval(interval); interval = null; }
    function chime() {
      if (!soundEnabled) return;
      try {
        if (!audioContext) audioContext = new (window.AudioContext || window.webkitAudioContext)();
        if (audioContext && audioContext.state === "suspended") audioContext.resume();
        const now = audioContext.currentTime;
        [0, .22].forEach((delay, i) => {
          const osc = audioContext.createOscillator();
          const gain = audioContext.createGain();
          osc.type = "sine"; osc.frequency.value = i ? 660 : 523;
          gain.gain.setValueAtTime(.0001, now + delay);
          gain.gain.exponentialRampToValueAtTime(.075, now + delay + .025);
          gain.gain.exponentialRampToValueAtTime(.0001, now + delay + .32);
          osc.connect(gain).connect(audioContext.destination);
          osc.start(now + delay); osc.stop(now + delay + .34);
        });
      } catch (_) { /* The visual completion state remains available without audio. */ }
    }
    function tick() {
      remainingSeconds = Math.max(0, (deadline - Date.now()) / 1000);
      if (remainingSeconds <= 0) {
        stopClock(); state = "done"; chime();
      }
      render();
    }
    function start() {
      if (state === "done") remainingSeconds = totalSeconds;
      deadline = Date.now() + remainingSeconds * 1000;
      state = "running"; tick(); interval = setInterval(tick, 100);
    }
    document.getElementById("start").addEventListener("click", start);
    document.getElementById("resume").addEventListener("click", start);
    document.getElementById("pause").addEventListener("click", () => {
      remainingSeconds = Math.max(0, (deadline - Date.now()) / 1000);
      stopClock(); state = "paused"; render();
    });
    document.getElementById("reset").addEventListener("click", () => {
      stopClock(); remainingSeconds = totalSeconds; state = "ready"; render();
    });
    document.querySelectorAll("[data-minutes]").forEach(button => {
      button.addEventListener("click", () => {
        stopClock();
        totalSeconds = Number(button.dataset.minutes) * 60;
        remainingSeconds = totalSeconds; state = "ready";
        document.querySelectorAll("[data-minutes]").forEach(b => b.setAttribute("aria-pressed", String(b === button)));
        document.getElementById("custom-duration").value = "";
        render();
      });
    });
    document.getElementById("custom-duration").addEventListener("input", event => {
      const minutes = Number(event.currentTarget.value);
      if (!Number.isInteger(minutes) || minutes < 1 || minutes > 180) return;
      stopClock();
      totalSeconds = minutes * 60;
      remainingSeconds = totalSeconds; state = "ready";
      document.querySelectorAll("[data-minutes]").forEach(button => button.setAttribute("aria-pressed", "false"));
      render();
    });
    document.querySelectorAll("[data-activity]").forEach(button => {
      button.addEventListener("click", () => {
        const activity = activities[button.dataset.activity];
        document.getElementById("activity-symbol").textContent = activity.symbol;
        document.getElementById("activity-name").textContent = activity.name;
        document.querySelectorAll("[data-activity]").forEach(b => b.setAttribute("aria-pressed", String(b === button)));
      });
    });
    document.getElementById("custom-activity").addEventListener("input", event => {
      const customName = event.currentTarget.value.trim();
      if (!customName) return;
      document.getElementById("activity-symbol").textContent = "✍️";
      document.getElementById("activity-name").textContent = customName;
      document.querySelectorAll("[data-activity]").forEach(button => button.setAttribute("aria-pressed", "false"));
    });
    document.getElementById("sound-toggle").addEventListener("click", event => {
      soundEnabled = !soundEnabled;
      event.currentTarget.setAttribute("aria-pressed", String(soundEnabled));
      document.getElementById("sound-off").classList.toggle("hidden", soundEnabled);
      document.getElementById("sound-on").classList.toggle("hidden", !soundEnabled);
      const indicator = document.getElementById("sound-indicator");
      indicator.classList.toggle("bg-[#d9e3db]", !soundEnabled);
      indicator.classList.toggle("bg-[#237b70]", soundEnabled);
      indicator.firstElementChild.style.transform = soundEnabled ? "translateX(16px)" : "";
    });
    render();
  </script>
